              "resolution": 300000,
              "template": "READY = data('k8s.node.condition_ready'{{#filter}}, filter={{{filter}}}{{/filter}},extrapolation='last_value', maxExtrapolations=-1).sum(by=['k8s.cluster.name', 'k8s.node.name']).equals(1).promote(by='condition', allow_missing={'condition':'Ready'})\nNOT_READY = data('k8s.node.condition_ready'{{#filter}}, filter={{{filter}}}{{/filter}},extrapolation='last_value', maxExtrapolations=-1).sum(by=['k8s.cluster.name', 'k8s.node.name']).equals(0).promote(by='condition', allow_missing={'condition':'Not ready'})\nUNKNOWN = data('k8s.node.condition_ready'{{#filter}}, filter={{{filter}}}{{/filter}},extrapolation='last_value', maxExtrapolations=-1).sum(by=['k8s.cluster.name', 'k8s.node.name']).equals(-1).promote(by='condition', allow_missing={'condition':'Unknown'})\nNA = data('k8s.node.condition_ready'{{#filter}}, filter={{{filter}}}{{/filter}},extrapolation='last_value', maxExtrapolations=-1).sum(by=['k8s.cluster.name', 'k8s.node.name']).map(lambda x: 2 if x is None else x).equals(2).promote(by='condition', allow_missing={'condition':'n/a'})\nNODE_CONDITION = union(READY,NOT_READY,UNKNOWN,NA)",
