            "job": {
              "filters": null,
              "resolution": 60000,
              "template": "TRANSACTIONS = data(\"oracledb.transactions.usage\", filter=filter(\"host.id\", \"*\")and filter(\"oracledb.instance.name\", \"*\") {{#filter}} and {{{filter}}}{{/filter}}).sum(by=[\"host.id\", \"oracledb.instance.name\", \"host.name\"]).rateofchange().sum(over=\"1d\")",
