              "minValue": 0,
              "range": null
            },
            "description": "This metric shows the percentage utilization of resources in last 24 hours against the total limit. Under 20% (green), over 80% (red).",
            "displayName": "Lock utilization (%)",
            "id": "oracle_db_instances_lock_utilization",
            "job": {
              "filters": null,
              "resolution": 60000,
              "template": "CURRENT_UTILIZATION = data(\"oracledb.enqueue_locks.usage\", filter=filter(\"host.id\", \"*\")and filter(\"oracledb.instance.name\", \"*\"){{#filter}} and {{{filter}}}{{/filter}}).sum(over=\"1d\").sum(by=[\"host.id\", \"oracledb.instance.name\", \"host.name\"])\nLIMIT_VALUE = data(\"oracledb.enqueue_locks.limit\", filter=filter(\"host.id\", \"*\")and filter(\"oracledb.instance.name\", \"*\"){{#filter}} and {{{filter}}}{{/filter}}).sum(by=[\"host.id\", \"oracledb.instance.name\", \"host.name\"]).sum(over=\"1d\")\nLOCK_UTILIZATION = ((CURRENT_UTILIZATION / LIMIT_VALUE) * 100).sum(by=[\"host.id\", \"oracledb.instance.name\", \"host.name\"])",
              "varName": "LOCK_UTILIZATION"
            },
            "metricSelectors": [
              "oracledb.enqueue_locks.limit",
              "oracledb.enqueue_locks.usage"
            ],
            "type": "metric",
            "valueFormat": "Percentage",
            "valueLabel": "Lock utilization",
            "valueType": null
          },
