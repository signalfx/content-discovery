            "description": "This metric shows the total time taken by foreground sessions executing database calls in last 24 hours (ms). Darker color indicate higher relative values.",
            "displayName": "Query Wait Time (ms)",
            "id": "oracle_db_instances_query_wait_time",
            "job": {
              "filters": null,
              "resolution": 60000,
              "template": "QUERY_WAIT_TIME = data(\"oracledb_wait_time*\"{{#filter}}, filter={{{filter}}}{{/filter}}).sum(over=\"1d\").sum(by=[\"host.id\", \"oracledb.instance.name\", \"host.name\"])\nTOTAL_QUERY_WAIT_TIME = (QUERY_WAIT_TIME * 1000)",
              "varName": "TOTAL_QUERY_WAIT_TIME"
            },
