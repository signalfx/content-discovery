            "description": "This metric shows the percentage utilization of table spaces from last 24 hours against the max bytes. Under 20% (green), over 80% (red).",
            "displayName": "Tablespace utilization (%)",
            "id": "oracle_db_instances_tablespace_utilization",
            "job": {
              "filters": null,
              "resolution": 60000,
              "template": "TS_USAGE = data(\"oracledb.tablespace_size.usage\", filter=filter(\"host.id\", \"*\")and filter(\"oracledb.instance.name\", \"*\") {{#filter}} and {{{filter}}}{{/filter}}).sum(by=[\"host.id\", \"oracledb.instance.name\", \"host.name\"]).sum(over=\"1d\")\n TS_LIMIT = data(\"oracledb.tablespace_size.limit\", filter=filter(\"host.id\", \"*\")and filter(\"oracledb.instance.name\", \"*\") {{#filter}} and {{{filter}}}{{/filter}}).sum(over=\"1d\").sum(by=[\"host.id\", \"oracledb.instance.name\", \"host.name\"])\n TABLESPACE_UTILISATION = ((TABLESPACE_BYTES / MAX_BYTES) * 100)",
              "varName": "TABLESPACE_UTILISATION"
