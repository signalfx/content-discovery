# Copy to contentforge/config.yaml (gitignored) and fill in values.
# Secrets should come from environment variables in CI; see contentforge/README.md.

slack:
  channel_name: test_ai_ootb
  # channel_id: C0123456789  # optional; set SLACK_CHANNEL_ID in CI for bot API

jira:
  base_url: https://splunk.atlassian.net
  cloud_id: db16805d-eccf-473e-abd4-5c291f63e55d
  project_key: BITS
  issue_type: Bug
  default_labels:
    - o11y-ootb
    - content-discovery

gitlab:
  base_url: https://cd.splunkdev.com
  project_path: observability/shared/content-discovery
  project_id: 9336
  target_branch: master
  default_labels:
    - o11y-ootb
  # GitLab user IDs for MR reviewers (not usernames)
  default_reviewer_ids: []
  # default_assignee_ids: []

signalbuddy:
  # Credentials: root .token file or SIGNALBUDDY_TOKEN env var (see syncer)
  realm: us0

workflow:
  branch_prefix: fix/bits-
  mr_draft: true
