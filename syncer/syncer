#!/usr/bin/env python3

"""
Content Syncer - Modern TUI for syncing SignalFx content
"""

import sys
from pathlib import Path
from typing import Optional

from textual.app import App, ComposeResult
from textual.containers import Container, Vertical, Horizontal
from textual.widgets import Footer, Static, Select, Label, Header, Tree, Button, RichLog
from textual.binding import Binding

# Add parent directory to path for imports
sys.path.insert(0, str(Path(__file__).parent))

from utils import (
    get_realm_config, 
    get_changed_files, 
    extract_resource_info,
    get_realm_for_env,
    get_token_for_env,
    base_api_url_from_realm,
    compare_json_objects,
    summarize_group_changes
)
from services.navigator_service import fetch_navigator_export_by_id, update_navigator
from services.detector_service import fetch_detector_export_by_id, update_detector
from services.group_service import fetch_group_export_by_id, update_dashboard_group
import json


class SyncerApp(App):
    """Content Syncer - Clean and Modern TUI"""
    
    CSS = """
    Screen {
        background: $surface;
    }
    
    Header {
        background: $primary;
        color: $text;
    }
    
    Header .header--title {
        text-style: bold;
